/* ============ STATE / STORAGE ============ */
const LS = "cn-practice-v1";
let store = JSON.parse(localStorage.getItem(LS) || "{}");
store.known = store.known || {};   // char -> true
store.weak  = store.weak  || {};   // char -> true
store.quiz  = store.quiz  || {right:0,total:0};
function save(){ localStorage.setItem(LS, JSON.stringify(store)); }

let range = [1,300];      // 1-indexed rank inclusive, or "weak"
let deck = [];            // current array of [char,pin,mean,rank]
let idx = 0;

function buildDeck(){
  const all = CHARS.map((c,i)=>[c[0],c[1],c[2],i+1]);
  if(range==="weak"){ deck = all.filter(c=>store.weak[c[0]]); }
  else { deck = all.filter(c=> c[3]>=range[0] && c[3]<=range[1]); }
  if(deck.length===0) deck = all.slice(0,1);
  idx = 0;
}

/* ============ SPEECH ============ */
let voices = [], chosenVoice = null;
function loadVoices(){
  voices = speechSynthesis.getVoices().filter(v=>/zh|cmn|chinese|普通话|中文/i.test(v.lang+ " " + v.name));
  const sel = document.getElementById("voiceSel");
  sel.innerHTML = "";
  if(voices.length===0){
    const o=document.createElement("option"); o.textContent="(no Chinese voice found)"; sel.appendChild(o);
  } else {
    voices.forEach((v,i)=>{ const o=document.createElement("option"); o.value=i; o.textContent=v.name+" ("+v.lang+")"; sel.appendChild(o);});
    chosenVoice = voices[0];
  }
}
loadVoices();
if(speechSynthesis.onvoiceschanged !== undefined) speechSynthesis.onvoiceschanged = loadVoices;
document.getElementById("voiceSel").addEventListener("change",e=>{ chosenVoice = voices[+e.target.value]||null; });

function speak(text){
  if(!text) return;
  try{
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = "zh-CN";
    if(chosenVoice) u.voice = chosenVoice;
    u.rate = parseFloat(document.getElementById("rate").value);
    speechSynthesis.speak(u);
  }catch(e){}
}
