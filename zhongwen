<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>汉字 · Chinese Practice</title>
<style>
  :root{
    --bg:#0f1115; --panel:#181b22; --panel2:#1f232c; --line:#2a2f3a;
    --txt:#e8eaf0; --muted:#9aa3b2; --accent:#e8553e; --accent2:#f0a04b;
    --good:#3fbf7f; --bad:#e05a5a; --blue:#5a9ce0;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:radial-gradient(1200px 600px at 50% -10%,#1a1d26,#0f1115);
    color:var(--txt);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    display:flex;flex-direction:column;align-items:center;min-height:100%;
  }
  header{width:100%;max-width:900px;padding:18px 16px 6px;text-align:center}
  h1{margin:0;font-size:22px;letter-spacing:.5px}
  h1 .cn{color:var(--accent);font-size:26px;margin-right:8px}
  .sub{color:var(--muted);font-size:13px;margin-top:4px}
  .wrap{width:100%;max-width:900px;padding:0 16px 60px}

  /* control bar */
  .bar{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin:14px 0;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between}
  .ctl{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
  .ctl label{font-weight:600;letter-spacing:.3px}
  .row{display:flex;gap:8px;align-items:center}
  select,input[type=range]{accent-color:var(--accent)}
  select{background:var(--panel2);color:var(--txt);border:1px solid var(--line);border-radius:8px;padding:6px 8px;font-size:13px}
  .chip{background:var(--panel2);border:1px solid var(--line);color:var(--muted);border-radius:20px;padding:5px 12px;font-size:12px;cursor:pointer;user-select:none}
  .chip:hover{border-color:var(--accent)}
  .chip.on{background:var(--accent);color:#fff;border-color:var(--accent)}

  /* tabs */
  .tabs{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 4px}
  .tab{flex:1;min-width:90px;text-align:center;padding:10px;border-radius:10px;background:var(--panel);border:1px solid var(--line);cursor:pointer;font-size:14px;color:var(--muted);font-weight:600}
  .tab.on{background:var(--accent);color:#fff;border-color:var(--accent)}

  .view{display:none}
  .view.on{display:block}

  /* flashcard */
  .card{background:linear-gradient(180deg,#20242e,#171a21);border:1px solid var(--line);border-radius:20px;padding:34px 20px;text-align:center;margin:14px 0;min-height:300px;display:flex;flex-direction:column;justify-content:center;align-items:center;cursor:pointer;position:relative}
  .rank{position:absolute;top:14px;left:16px;font-size:12px;color:var(--muted)}
  .star{position:absolute;top:12px;right:16px;font-size:20px;cursor:pointer;opacity:.5}
  .star.on{opacity:1}
  .hanzi{font-size:120px;line-height:1.1;font-weight:500}
  .pin{font-size:30px;color:var(--accent2);margin-top:6px;min-height:36px}
  .mean{font-size:20px;color:var(--txt);margin-top:8px;min-height:26px}
  .hint{color:var(--muted);font-size:12px;margin-top:14px}
  .answer{opacity:0;transition:opacity .15s}
  .card.flip .answer{opacity:1}

  .btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:10px 0}
  button.act{background:var(--panel2);color:var(--txt);border:1px solid var(--line);border-radius:10px;padding:11px 16px;font-size:14px;cursor:pointer;font-weight:600}
  button.act:hover{border-color:var(--accent)}
  button.act.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  button.act.good{background:var(--good);border-color:var(--good);color:#06281a}
  button.act.bad{background:var(--bad);border-color:var(--bad);color:#fff}
  button.act:disabled{opacity:.4;cursor:default}
  .speak{background:var(--blue);border-color:var(--blue);color:#04203f}

  .progress{height:6px;background:var(--panel2);border-radius:4px;overflow:hidden;margin:6px 0}
  .progress>div{height:100%;background:var(--accent);width:0%}
  .meta{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:4px}

  /* quiz */
  .opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
  .opt{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:16px;font-size:16px;cursor:pointer;text-align:center}
  .opt:hover{border-color:var(--accent)}
  .opt.correct{background:var(--good);color:#06281a;border-color:var(--good)}
  .opt.wrong{background:var(--bad);color:#fff;border-color:var(--bad)}
  .opt.dim{opacity:.45}

  /* lists */
  .list{display:flex;flex-direction:column;gap:8px;margin-top:12px}
  .item{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;align-items:center;gap:14px}
  .item .cn{font-size:26px;min-width:auto}
  .item .info{flex:1}
  .item .ipin{color:var(--accent2);font-size:15px}
  .item .imean{color:var(--muted);font-size:14px;margin-top:2px}
  .item .play{background:var(--blue);border:none;color:#04203f;border-radius:50%;width:40px;height:40px;font-size:18px;cursor:pointer;flex-shrink:0}
  .ph .cn{font-size:22px;line-height:1.4}

  .stat{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
  .box{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;text-align:center}
  .box .n{font-size:30px;font-weight:700;color:var(--accent2)}
  .box .l{font-size:12px;color:var(--muted);margin-top:4px}
  .danger{color:var(--bad);cursor:pointer;text-decoration:underline;font-size:12px}
  .note{color:var(--muted);font-size:12px;text-align:center;margin-top:18px;line-height:1.6}
  /* practice */
  .prow{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}
  .badge{background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:3px 9px;font-size:11px;color:var(--accent2);text-transform:uppercase;letter-spacing:.5px;font-weight:700}
  .dots{display:flex;gap:4px}
  .dots i{width:9px;height:9px;border-radius:50%;background:var(--panel2);border:1px solid var(--line);display:inline-block}
  .dots i.f{background:var(--good);border-color:var(--good)}
  .pprompt{color:var(--muted);font-size:13px;font-weight:600;margin-left:auto}
  .pcard .answer{opacity:0;transition:opacity .12s}
  .pcard.reveal .answer{opacity:1}
  .opt{position:relative}
  .optk{position:absolute;left:8px;top:6px;font-size:10px;color:var(--muted);opacity:.55}
  .prow2{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-top:18px;color:var(--muted);font-size:12px}
  .prow2 label{display:flex;align-items:center;gap:5px;cursor:pointer}
  @media(max-width:520px){.hanzi{font-size:90px}.opts{grid-template-columns:1fr}.stat{grid-template-columns:1fr 1fr}.pprompt{margin-left:0;width:100%}}
</style>
</head>
<body>
<header>
  <h1><span class="cn">汉字</span>Chinese Practice</h1>
  <div class="sub">Frequency-ordered characters · pinyin · voice · words & phrases</div>
</header>

<div class="wrap">

  <div class="bar">
    <div class="ctl">
      <label>Frequency range (by rank)</label>
      <div class="row">
        <span class="chip" data-range="1,150">1–150 (your zone)</span>
        <span class="chip on" data-range="1,300">1–300</span>
        <span class="chip" data-range="100,150">focus 100–150</span>
        <span class="chip" data-range="weak">⭐ weak only</span>
      </div>
    </div>
    <div class="ctl">
      <label>Voice</label>
      <div class="row">
        <select id="voiceSel"></select>
        <label style="display:flex;align-items:center;gap:4px;font-size:11px">speed
          <input id="rate" type="range" min="0.5" max="1.2" step="0.1" value="0.85" style="width:70px">
        </label>
      </div>
    </div>
    <div class="ctl">
      <label>Options</label>
      <div class="row">
        <span class="chip on" id="autoplay">🔊 auto-play</span>
      </div>
    </div>
  </div>

  <div class="tabs">
    <div class="tab on" data-view="practice">⚡ Practice</div>
    <div class="tab" data-view="flash">Flashcards</div>
    <div class="tab" data-view="quiz">Quiz</div>
    <div class="tab" data-view="words">Words</div>
    <div class="tab" data-view="phrases">Phrases</div>
    <div class="tab" data-view="stats">Stats</div>
  </div>

  <!-- PRACTICE (adaptive rapid-fire) -->
  <div class="view on" id="view-practice">
    <div class="prow">
      <span class="badge" id="pType">char</span>
      <span class="dots" id="pDots"></span>
      <span class="pprompt" id="pPrompt"></span>
    </div>
    <div class="card pcard" id="pCard" style="min-height:230px">
      <div class="hanzi" id="pBig">字</div>
      <div class="pin" id="pBigPin" style="opacity:0"></div>
      <div class="answer" id="pReveal"></div>
      <div class="hint" id="pHint" style="display:none"></div>
    </div>
    <div class="row" style="justify-content:center;margin:8px 0;gap:8px">
      <button class="act speak" id="pReplay">🔊 replay</button>
      <button class="act" id="pSkip">skip ›</button>
    </div>
    <div class="opts" id="pOpts" style="display:none"></div>
    <div class="btns" id="pGrade" style="display:none">
      <button class="act bad" id="pMiss">❌ Missed (1)</button>
      <button class="act good" id="pGot">✅ Got it (2)</button>
    </div>
    <div class="meta" style="margin-top:12px"><span id="pStats"></span><span id="pStreak"></span></div>
    <div class="prow2" id="pToggles"></div>
  </div>

  <!-- FLASHCARDS -->
  <div class="view" id="view-flash">
    <div class="card" id="card">
      <span class="rank" id="fRank"></span>
      <span class="star" id="fStar" title="mark as weak / favorite">★</span>
      <div class="hanzi" id="fHanzi">字</div>
      <div class="answer">
        <div class="pin" id="fPin"></div>
        <div class="mean" id="fMean"></div>
      </div>
      <div class="hint" id="fHint">tap card to reveal</div>
    </div>
    <div class="btns">
      <button class="act speak" id="fSpeak">🔊 Say it</button>
      <button class="act" id="fPrev">‹ Prev</button>
      <button class="act bad" id="fAgain">Again</button>
      <button class="act good" id="fGot">Got it ›</button>
      <button class="act" id="fShuffle">🔀 Shuffle</button>
    </div>
    <div class="progress"><div id="fBar"></div></div>
    <div class="meta"><span id="fPos"></span><span id="fKnown"></span></div>
  </div>

  <!-- QUIZ -->
  <div class="view" id="view-quiz">
    <div class="card" style="min-height:170px;cursor:default;padding:24px">
      <span class="rank" id="qRank"></span>
      <div class="hanzi" id="qHanzi" style="font-size:88px">字</div>
      <div class="pin" id="qPin" style="opacity:0"></div>
    </div>
    <div class="row" style="justify-content:center;margin:6px 0">
      <button class="act speak" id="qSpeak">🔊 hear</button>
      <span style="color:var(--muted);font-size:13px;align-self:center" id="qPrompt">Pick the meaning:</span>
    </div>
    <div class="opts" id="qOpts"></div>
    <div class="meta" style="margin-top:14px"><span id="qScore">Score: 0 / 0</span><span id="qStreak"></span></div>
  </div>

  <!-- WORDS -->
  <div class="view" id="view-words">
    <div class="list" id="wordList"></div>
  </div>

  <!-- PHRASES -->
  <div class="view" id="view-phrases">
    <div class="list ph" id="phraseList"></div>
  </div>

  <!-- STATS -->
  <div class="view" id="view-stats">
    <div class="stat">
      <div class="box"><div class="n" id="sKnown">0</div><div class="l">characters learned</div></div>
      <div class="box"><div class="n" id="sWeak">0</div><div class="l">marked weak ⭐</div></div>
      <div class="box"><div class="n" id="sQuiz">0%</div><div class="l">quiz accuracy</div></div>
    </div>
    <p class="note">
      Progress is saved in your browser (localStorage). “Got it” marks a character learned;
      “Again” / the ★ marks it weak so you can drill it with the <b>⭐ weak only</b> range.<br>
      <span class="danger" id="reset">Reset all progress</span>
    </p>
  </div>

  <p class="note">
    Tip: you're ~rank 100–150 in your Refold deck — use <b>1–150</b> to consolidate, then push the range out.
    Voice uses your device's built-in Mandarin (zh-CN) speech. If no Chinese voice shows up, install one in your OS settings.
  </p>
</div>

