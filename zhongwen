/* ============ QUIZ ============ */
let qCur=null, qStreak=0;
function newQuiz(){
  document.getElementById("qPin").style.opacity=0;
  qCur = deck[Math.floor(Math.random()*deck.length)];
  document.getElementById("qHanzi").textContent=qCur[0];
  document.getElementById("qPin").textContent=qCur[1];
  document.getElementById("qRank").textContent = (range==="weak"?"⭐":"#"+qCur[3]);
  // build 4 options of meanings
  const pool = CHARS.slice();
  const opts=[qCur[2]]; let guard=0;
  while(opts.length<4 && guard++<200){
    const r=pool[Math.floor(Math.random()*pool.length)][2];
    if(!opts.includes(r)) opts.push(r);
  }
  for(let i=opts.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[opts[i],opts[j]]=[opts[j],opts[i]];}
  const box=document.getElementById("qOpts"); box.innerHTML="";
  opts.forEach(o=>{
    const d=document.createElement("div"); d.className="opt"; d.textContent=o;
    d.addEventListener("click",()=>answer(d,o)); box.appendChild(d);
  });
  if(autoplayOn) speak(qCur[0]);
}
function answer(el,val){
  const right = val===qCur[2];
  store.quiz.total++; if(right){store.quiz.right++;qStreak++;} else qStreak=0;
  if(right){ const ch=qCur[0]; store.known[ch]=true; if(store.weak[ch])delete store.weak[ch]; }
  else { store.weak[qCur[0]]=true; }
  save(); renderStats();
  document.getElementById("qPin").style.opacity=1;
  document.querySelectorAll("#qOpts .opt").forEach(o=>{
    o.style.pointerEvents="none";
    if(o.textContent===qCur[2]) o.classList.add("correct");
    else if(o===el) o.classList.add("wrong");
    else o.classList.add("dim");
  });
  document.getElementById("qScore").textContent="Score: "+store.quiz.right+" / "+store.quiz.total;
  document.getElementById("qStreak").textContent = qStreak>1?("🔥 streak "+qStreak):"";
  setTimeout(newQuiz, right?700:1500);
}
