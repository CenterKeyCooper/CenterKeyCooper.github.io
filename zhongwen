/* ============ PRACTICE: adaptive rapid-fire engine ============ */
store.srs = store.srs || {};                       // key -> {s:0..5, right, miss, seen}
store.practice = store.practice || {seen:0,right:0};
let pInclude = store.pInclude || {char:true,word:true,phrase:true};
let pAuto = store.pAuto!==false;
let pPool=[], pCur=null, pMode=null, pAnswered=false, pStreak=0;
let pLast=null, pLastType=null, pLastMode=null, pTimer=null, pRecallReveal=null;
const pKey = it => it.type+":"+it.cn;
const pcShuffle = a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;};
const pClean = s => s.replace(/[…？！。，、]/g,"");

function pBuildPool(){
  const chars = CHARS.map((c,i)=>({type:'char',cn:c[0],pin:c[1],en:c[2],rank:i+1}));
  let pool=[];
  if(pInclude.char){
    const cs = range==="weak" ? chars.filter(c=>store.weak[c.cn])
             : chars.filter(c=>c.rank>=range[0] && c.rank<=range[1]);
    pool=pool.concat(cs);
  }
  if(pInclude.word) pool=pool.concat(WORDS.map(w=>({type:'word',cn:w[0],pin:w[1],en:w[2]})));
  if(pInclude.phrase) pool=pool.concat(PHRASES.map(p=>({type:'phrase',cn:p[0],pin:p[1],en:p[2]})));
  pPool=pool;
}

/* weighted draw: weak & new surface more, no immediate repeat, interleave types */
function pPick(){
  if(!pPool.length) return null;
  const w = pPool.map(it=>{
    const k=pKey(it), rec=store.srs[k], st=rec?rec.s:0;
    let x = rec ? (7-st) : 4;                    // new items = medium; mastered = low
    if(rec && rec.miss>rec.right) x+=2;          // historically struggled → boost
    if(k===pLast) return 0;                      // never repeat back-to-back
    if(it.type===pLastType) x*=0.45;             // bias toward switching type
    return Math.max(x,0.08);
  });
  let r=Math.random()*w.reduce((a,b)=>a+b,0);
  for(let i=0;i<pPool.length;i++){ r-=w[i]; if(r<=0) return pPool[i]; }
  return pPool[pPool.length-1];
}

/* varied question type, never the same drill twice in a row */
function pModeFor(it){
  let modes = it.type==='char'  ? ['h2m','h2p','m2h','listen','recall']
            : it.type==='word'  ? ['h2m','m2h','listen','recall']
            :                      ['p_listen','p_read','p_say'];
  modes = modes.filter(m=>m!==pLastMode); if(!modes.length) modes=['recall'];
  return modes[Math.floor(Math.random()*modes.length)];
}

function pDistract(it,n,field){
  let same = pPool.filter(x=>x.type===it.type && x.cn!==it.cn && x[field]!==it[field]);
  if(same.length<n) same = pPool.filter(x=>x.cn!==it.cn && x[field]!==it[field]);
  return pcShuffle(same.slice()).slice(0,n);
}

const pCard=document.getElementById("pCard");
function pSetBig(t,size){ const e=document.getElementById("pBig"); e.textContent=t; e.style.fontSize=size+"px"; }
function pDots(it){
  const st=(store.srs[pKey(it)]||{}).s||0; let h="";
  for(let i=0;i<5;i++) h+=`<i class="${i<st?'f':''}"></i>`;
  document.getElementById("pDots").innerHTML=h;
}
function pSetStats(){
  const a=store.practice, acc=a.seen?Math.round(a.right/a.seen*100):0;
  document.getElementById("pStats").textContent=`seen ${a.seen} · acc ${acc}%`;
  document.getElementById("pStreak").textContent = pStreak>1?("🔥 "+pStreak):"";
}

let pCorrectIt=null;
function pBuildMCQ(opts, correctIt, label){
  pCorrectIt=correctIt;
  const box=document.getElementById("pOpts"); box.style.display="grid"; box.innerHTML="";
  opts.forEach((o,i)=>{
    const d=document.createElement("div"); d.className="opt"; d.dataset.cn=o.cn;
    d.innerHTML=`<span class="optk">${i+1}</span>${label(o)}`;
    d.addEventListener("click",()=>pAnswerMCQ(o));
    box.appendChild(d);
  });
}
function pAnswerMCQ(picked){
  if(pAnswered) return; pAnswered=true;
  const ok = picked.cn===pCorrectIt.cn;
  document.querySelectorAll("#pOpts .opt").forEach(o=>{
    o.style.pointerEvents="none";
    if(o.dataset.cn===pCorrectIt.cn) o.classList.add("correct");
    else if(o.dataset.cn===picked.cn) o.classList.add("wrong");
    else o.classList.add("dim");
  });
  document.getElementById("pBigPin").textContent=pCur.pin;
  document.getElementById("pBigPin").style.opacity=.85;
  pGrade(ok);
  if(pAuto){ clearTimeout(pTimer); pTimer=setTimeout(pNext, ok?700:1500); }
  else document.getElementById("pSkip").textContent="next ›";
}

function pShowReveal(html, speakCn){
  if(pAnswered || pCard.classList.contains("reveal")) return;
  pCard.classList.add("reveal");
  document.getElementById("pReveal").innerHTML=html;
  document.getElementById("pHint").style.display="none";
  document.getElementById("pGrade").style.display="flex";
  if(speakCn) speak(pClean(speakCn));
}
function pGradeRecall(ok){
  if(pAnswered) return; pAnswered=true;
  pGrade(ok); clearTimeout(pTimer); pTimer=setTimeout(pNext,300);
}

function pGrade(ok){
  const k=pKey(pCur), rec=store.srs[k]||{s:0,right:0,miss:0,seen:0};
  rec.seen++; if(ok){rec.right++; rec.s=Math.min(5,rec.s+1);} else {rec.miss++; rec.s=Math.max(0,rec.s-1);}
  store.srs[k]=rec;
  store.practice.seen++; if(ok) store.practice.right++;
  pStreak = ok?pStreak+1:0;
  if(pCur.type==='char'){
    if(ok){ store.known[pCur.cn]=true; if(rec.s>=2 && store.weak[pCur.cn]) delete store.weak[pCur.cn]; }
    else store.weak[pCur.cn]=true;
  } else if(!ok){ store.weak[pCur.cn]=true; }
  save(); pSetStats(); renderStats();
}

function pNext(){
  clearTimeout(pTimer); pAnswered=false; pRecallReveal=null; pCorrectIt=null;
  pCur=pPick();
  const opts=document.getElementById("pOpts"), grade=document.getElementById("pGrade");
  opts.innerHTML=""; opts.style.display="none"; grade.style.display="none";
  document.getElementById("pReveal").innerHTML=""; pCard.classList.remove("reveal");
  document.getElementById("pHint").style.display="none";
  document.getElementById("pBigPin").style.opacity=0;
  document.getElementById("pSkip").textContent="skip ›";
  const P=s=>document.getElementById("pPrompt").textContent=s;
  if(!pCur){
    pSetBig("∅",60); P("No items — enable a type below or widen the range.");
    document.getElementById("pType").textContent="—"; document.getElementById("pDots").innerHTML=""; return;
  }
  pMode=pModeFor(pCur); pLast=pKey(pCur); pLastType=pCur.type; pLastMode=pMode;
  document.getElementById("pType").textContent=pCur.type; pDots(pCur);
  const cnBig = pCur.type==='char'?96 : pCur.type==='word'?58 : 30;
  const optBig = o=>`<span style="font-size:22px">${o.cn}</span>`;

  switch(pMode){
    case 'h2m':
      P("What does it mean?"); pSetBig(pCur.cn,cnBig);
      pBuildMCQ(pcShuffle([pCur,...pDistract(pCur,3,'en')]), pCur, o=>o.en); break;
    case 'h2p':
      P("Pick the pinyin"); pSetBig(pCur.cn,cnBig);
      pBuildMCQ(pcShuffle([pCur,...pDistract(pCur,3,'pin')]), pCur, o=>o.pin); break;
    case 'm2h':
      P("Which one means this?"); pSetBig(pCur.en,24);
      pBuildMCQ(pcShuffle([pCur,...pDistract(pCur,3,'cn')]), pCur, optBig); break;
    case 'listen':
      P("Listen — pick the character"); pSetBig("🔊",70); speak(pClean(pCur.cn));
      pBuildMCQ(pcShuffle([pCur,...pDistract(pCur,3,'cn')]), pCur, optBig); break;
    case 'recall':
      P("Recall: pinyin + meaning"); pSetBig(pCur.cn,cnBig);
      document.getElementById("pHint").textContent="tap card / space to reveal";
      document.getElementById("pHint").style.display="block";
      pRecallReveal=()=>pShowReveal(`<div class="pin">${pCur.pin}</div><div class="mean">${pCur.en}</div>`, pCur.cn); break;
    case 'p_listen':
      P("Listen — what does it mean?"); pSetBig("🔊",70); speak(pClean(pCur.cn));
      pBuildMCQ(pcShuffle([pCur,...pDistract(pCur,3,'en')]), pCur, o=>o.en); break;
    case 'p_read':
      P("Read it — what does it mean?"); pSetBig(pCur.cn,30);
      document.getElementById("pHint").textContent="tap / space to reveal";
      document.getElementById("pHint").style.display="block";
      pRecallReveal=()=>pShowReveal(`<div class="pin">${pCur.pin}</div><div class="mean">${pCur.en}</div>`, pCur.cn); break;
    case 'p_say':
      P("Say it in Chinese:"); pSetBig(pCur.en,22);
      document.getElementById("pHint").textContent="say it aloud, then tap / space to check";
      document.getElementById("pHint").style.display="block";
      pRecallReveal=()=>pShowReveal(`<div class="hanzi" style="font-size:34px">${pCur.cn}</div><div class="pin">${pCur.pin}</div>`, pCur.cn); break;
  }
  pSetStats();
}

pCard.addEventListener("click",()=>{ if(pRecallReveal) pRecallReveal(); });
document.getElementById("pReplay").addEventListener("click",()=>{ if(pCur) speak(pClean(pCur.cn)); });
document.getElementById("pSkip").addEventListener("click",pNext);
document.getElementById("pMiss").addEventListener("click",()=>pGradeRecall(false));
document.getElementById("pGot").addEventListener("click",()=>pGradeRecall(true));

function pRenderToggles(){
  document.getElementById("pToggles").innerHTML=
    `<label><input type="checkbox" id="tgChar" ${pInclude.char?'checked':''}> characters</label>`+
    `<label><input type="checkbox" id="tgWord" ${pInclude.word?'checked':''}> words</label>`+
    `<label><input type="checkbox" id="tgPhrase" ${pInclude.phrase?'checked':''}> phrases</label>`+
    `<label><input type="checkbox" id="tgAuto" ${pAuto?'checked':''}> auto-advance</label>`;
  const upd=()=>{
    pInclude={char:document.getElementById("tgChar").checked,word:document.getElementById("tgWord").checked,phrase:document.getElementById("tgPhrase").checked};
    pAuto=document.getElementById("tgAuto").checked;
    store.pInclude=pInclude; store.pAuto=pAuto; save();
    pBuildPool(); pNext();
  };
  ["tgChar","tgWord","tgPhrase","tgAuto"].forEach(id=>document.getElementById(id).addEventListener("change",upd));
}

document.addEventListener("keydown",e=>{
  if(!document.getElementById("view-practice").classList.contains("on")) return;
  if(e.target.tagName==="INPUT") return;
  const mcqOpen = document.getElementById("pOpts").style.display==="grid" && !pAnswered;
  const gradeOpen = document.getElementById("pGrade").style.display==="flex";
  if(mcqOpen && /^[1-4]$/.test(e.key)){ const el=document.querySelectorAll("#pOpts .opt")[+e.key-1]; if(el) el.click(); }
  else if(gradeOpen && e.key==="1") document.getElementById("pMiss").click();
  else if(gradeOpen && e.key==="2") document.getElementById("pGot").click();
  else if(e.code==="Space"){ e.preventDefault(); if(pRecallReveal) pRecallReveal(); else if(pAnswered) pNext(); }
  else if(e.key==="r") document.getElementById("pReplay").click();
  else if(e.key==="n") pNext();
});

/* ============ INIT ============ */
buildDeck(); renderFlash(); renderStats();
pBuildPool(); pRenderToggles(); pNext();
</script>
